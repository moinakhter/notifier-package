SECRET_KEY=django-insecure-notifier-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database (Leave USE_POSTGRES=False for local SQLite, True for PostgreSQL in Docker/Prod)
USE_POSTGRES=False
DB_NAME=notifier_service
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Throttling & Pipeline
NOTIFICATION_RATE_LIMIT=100
NOTIFICATION_DEDUP_WINDOW=300
NOTIFICATION_GROUP_WINDOW=60
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF=60
